# AI News Daily Report server config  ->  copy to ~/.ai-daily/config.env  (chmod 600)

# ---- email (QQ 邮箱：设置 → 账户 → 开启 IMAP/SMTP 服务，授权码填 SMTP_PASS，不是 QQ 密码) ----
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=sender@example.com
SMTP_PASS=
MAIL_TO=reviewer@example.com
# MAIL_FROM="AI Daily Bot <sender@example.com>"

# ---- reply approval (直接回复完整预览邮件，正文只写：确认) ----
# 核实 IMAP 后启用 ai-daily-review.timer；仅 MAIL_TO 中的收件人可确认对应版本。
MAIL_APPROVAL_ENABLED=0
IMAP_HOST=imap.qq.com
IMAP_PORT=993
IMAP_MAILBOX=INBOX
# 默认复用 SMTP_USER / SMTP_PASS。非QQ邮箱或独立收信账号可覆盖：
# IMAP_USER=
# IMAP_PASS=
# MAIL_REPLY_TO=       # 默认 IMAP_USER 或 SMTP_USER，必须能收到回复
# MAIL_APPROVERS=      # 默认 MAIL_TO；经用户授权的确认邮箱/别名，逗号分隔，不改变预览收件人

# ---- behaviour ----
# preview = 完整正文和封面发邮件后停止（默认）；不登录公众号、不创建草稿、不发表
# 邮件监听核验明确确认后自动调用 publish；日常定时任务仍保持 preview
# 手动 draft / publish 必须使用已获用户确认的 APPROVED_ARTICLE_SHA256
PUBLISH_MODE=preview
# 1 = 试运行：写文章 + 生成封面 + 邮件，不碰公众号草稿/发表
DRY_RUN=0
# 北京时间几点之前不跑（防止服务器早上开机时补跑出一篇内容很少的日报），留空 = 不限制
RUN_AFTER_HOUR=
# 等待扫码登录的最长秒数
LOGIN_WAIT=3600
# 公众号作者栏最多8个字；覆盖Markdown元数据，不修改已审阅的标题、正文或封面。
# WECHAT_AUTHOR=AI日报

# ---- GPT Responses API（无需 Copilot CLI、GitHub 登录或订阅）----
# 完整接口地址，不是仅填域名或 /v1；建议 HTTPS。这里是占位符，改成你的 endpoint。
GPT_ENDPOINT=https://your-gpt-endpoint.example/v1/responses
GPT_API_KEY=
# 必须使用 endpoint 实际支持的模型 ID；gpt-6.1-sol 仅为示例，可按服务商命名调整。
GPT_MODEL=gpt-6.1-sol
# prompt = 提示词要求 JSON，再由本地严格校验（兼容不支持 text.format 的网关）
# json_object = 额外发送 text.format.type=json_object，仅在服务商支持时使用；不兼容时不自动回退
GPT_JSON_MODE=prompt
# 每次 API 请求的最长秒数；429/5xx 最多请求3次，其余HTTP错误直接停止。
GPT_TIMEOUT_SECONDS=600
# 含推理与正文的输出 token 上限；不足会明确失败，不发布截断文章。
GPT_MAX_OUTPUT_TOKENS=24000
# 抓取原文 + 核实 + 写稿整个阶段最长执行时间
GPT_JOB_TIMEOUT=60m

# ---- browser ----
# CHROME_PATH=/usr/bin/google-chrome
# 在 Docker/LXC 容器里跑、Chrome 报 sandbox 错误时打开（检测到 /.dockerenv 会自动打开）
# CHROME_NO_SANDBOX=1
# CDP_PORT=9333

# ---- proxy（可选）----
# 用于 install.sh 下载以及 GPT API 调用；大陆新闻和公众号均直连
# 支持 socks5h://host:port 或 http://host:port
# PROXY=socks5h://proxy.example.com:7890
# endpoint 在局域网时可直连；多个主机用逗号分隔，不带协议或路径
# PROXY_NO_PROXY=gpt.internal.example
# npm/bun 走国内镜像（代理是 socks 时建议开）
# NPM_REGISTRY=https://registry.npmmirror.com
